# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Rust
crates/target/
target/

# Node / Next.js
node_modules/
web/node_modules
web/.next/
web/out/

# Data & runtime artifacts
# 注意：这里只能写 data/<子目录>/ 或 data/<模式>，不能写裸的 `data/`
# —— gitignore 里不带前导斜杠的目录模式匹配**任意层级**，裸 `data/` 会把
# src/lquant/data/（数据模块源码）一起忽略掉，new file 静默不入库。
data/duckdb/
data/parquet/
data/cache/
data/logs/
/logs/
data/reports/
# agent 会话库（data/ask.db）等 sqlite 运行时文件
data/*.db
data/*.db-shm
data/*.db-wal
.run/
*.duckdb
*.wal

# Build artifacts
dist/
*.tar.gz
web/tsconfig.tsbuildinfo

# Claude Code / OMC 本地状态。
# 注意：.claude/commands/ 和 .claude/skills/dev-workflow/ 是**有意入库**的
# （团队共享的 slash 命令与 skill），所以不能整目录忽略 .claude/ ——
# 否则这些文件的后续改动会从 git status 里消失。只忽略本机内部那几项。
/.claude/worktrees/
/.claude/CLAUDE.md
/.claude/skills/wiki/

# Env & secrets
.env
.env.*

# TS build info
*.tsbuildinfo

# OMC 会话状态
.omc/

# worktree 内指向主仓数据的符号链接(锚定仓库根,避免误伤子目录同名路径)
/data

# coverage 门禁产物
coverage.xml
coverage.json
.coverage
htmlcov/

# qlib 接入：专用 venv 与工作流运行时产物
.venv-qlib/
mlruns/
data/qlib/
data/qlib-smoke/

# AlphaPurify 交叉验证：专用 venv、uv 缓存与运行产物
.venv-alphapurify/
.uv-cache/
.xval-out*/
# 克隆下来做源码级对照的上游仓库（只读参考，不入库）
.vendor/

web/coverage/
web/test-results/
web/playwright-report/

# 嵌套 git 仓：/lquant/ 下是一个独立仓库（有自己的 .git），`git add -A` 会把它
# 提交成 gitlink —— 公开仓的读者拿不到内容，只看到一个指向不存在仓库的空条目。
# 前导斜杠锚定根目录，避免把 src/lquant/（数据模块源码，必须入库）一起忽略掉。
/lquant/

# 内部工具与临时产物
/.idea/
/.tools/
.tmp_*
.secret-scan*.json