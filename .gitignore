# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Rust
crates/target/
target/

# Node / Next.js
node_modules/
web/.next/
web/out/

# Data & runtime artifacts
# 注意：这里只能写 data/<子目录>/ 或 data/<模式>，不能写裸的 `data/`
# —— gitignore 里不带前导斜杠的目录模式匹配**任意层级**，裸 `data/` 会把
# src/lquant/data/（数据模块源码）一起忽略掉，new file 静默不入库。
data/duckdb/
data/parquet/
data/cache/
data/logs/
/logs/
data/reports/
# agent 会话库（data/ask.db）等 sqlite 运行时文件
data/*.db
data/*.db-shm
data/*.db-wal
.run/
*.duckdb
*.wal

# Build artifacts
dist/
*.tar.gz
web/tsconfig.tsbuildinfo

# Claude
.claude/worktrees/

# Env & secrets
.env
.env.*

# TS build info
*.tsbuildinfo

# OMC 会话状态
.omc/

# worktree 内指向主仓数据的符号链接(锚定仓库根,避免误伤子目录同名路径)
/data

# coverage 门禁产物
coverage.xml
coverage.json
.coverage
htmlcov/

# qlib 接入：专用 venv 与工作流运行时产物
.venv-qlib/
mlruns/
data/qlib/
data/qlib-smoke/

web/coverage/
web/test-results/
web/playwright-report/
