#!/usr/bin/env bash
# 提交前检查：快速失败，只跑不耗时的检查（<10s）
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "==> pre-commit: 快速检查"

# 1) Python 语法/风格（有 .venv 用它，没有则跳过）
if [ -x .venv/bin/ruff ]; then
  .venv/bin/ruff check src/ scripts/ || {
    echo "✗ ruff 检查失败，先修复或 ./lquant.sh install 补装依赖"; exit 1; }
fi

# 2) 禁止提交密钥（简单启发式）
if git diff --cached -U0 | grep -InE \
    '(api[_-]?key|secret|token|password)\s*=\s*["'"'"'][A-Za-z0-9+/]{16,}'; then
  echo "✗ 疑似硬编码密钥，请移到 .env"; exit 1
fi

echo "==> pre-commit 通过"
