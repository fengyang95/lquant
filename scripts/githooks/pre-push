#!/usr/bin/env bash
# 推送前检查：密钥扫描（快，先跑）+ 改动相关测试（全量逃生门见下）
#
# 注意：测试里有依赖数据的用例（API / sync），所以先做环境自愈 ——
# 缺库建库、缺数据生成演示数据兜底，避免把"没跑过 bootstrap"误判成代码问题。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "==> pre-push: 密钥扫描 + 改动相关测试（覆盖率门禁在 CI）"

# 扫描脚本解析：优先当前工作树的；旧分支的 worktree 里没有这个文件，
# 退回钩子所在的主仓 —— 否则那 60+ 个 worktree 的 push 会以「疑似密钥」
# 这种误导性信息失败（真实原因是命令根本不存在）。
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"
SCAN="scripts/secret_scan.sh"
if [ ! -f "$SCAN" ]; then
  SCAN="$MAIN_ROOT/scripts/secret_scan.sh"
fi

# git 通过 stdin 把待推送的 ref 列表交给 pre-push（<local ref> <sha> <remote ref> <sha>）。
# 必须**最先**把它读走：后面的 pytest 会继承同一个 stdin，不读走这里就解析不到推送范围。
# `-t 0` 为真说明是手动执行（无 stdin），此时 cat 会一直等输入，直接跳过范围扫描。
PUSH_REFS="$(mktemp "${TMPDIR:-/tmp}/lq-push-refs.XXXXXX")"
trap 'rm -f "$PUSH_REFS"' EXIT
if [ -t 0 ]; then
  : > "$PUSH_REFS"
else
  cat > "$PUSH_REFS"
fi

# --- 0) 密钥扫描：刻意放在测试之前 -------------------------------------------
# 两个理由：
#   ① 测试要跑几分钟，先扫密钥才能在"这次 push 会泄露"时立刻失败；
#   ② 用**独立**开关。LQ_SKIP_PUSH_CHECK=1 是"跳过测试"的日常逃生门，
#      不该顺带把安全门禁也关掉 —— 否则跳过测试的人会在不知情下裸奔推送。
#      要跳过得显式写 LQ_SKIP_SECRET_SCAN=1，是一次有意识的操作。
if [ "${LQ_SKIP_SECRET_SCAN:-0}" = "1" ]; then
  echo "    LQ_SKIP_SECRET_SCAN=1，跳过密钥扫描（不推荐）"
else
  bash "$SCAN" push "$PUSH_REFS" || {
    echo "✗ 推送范围发现疑似密钥，已阻止 push。"
    echo "  · 真密钥：先撤销/轮换该凭证，再清理提交（见 docs/SECRET_HYGIENE.md）"
    echo "  · 假阳性：改 .gitleaks.toml 白名单并写明理由"
    exit 1
  }
fi

# 跳过开关（CI 上或临时放行）：LQ_SKIP_PUSH_CHECK=1 git push 或 git push --no-verify
# 注意：它只跳过测试与覆盖率，**不**跳过上面的密钥扫描。
if [ "${LQ_SKIP_PUSH_CHECK:-0}" = "1" ]; then
  echo "    LQ_SKIP_PUSH_CHECK=1，跳过测试与覆盖率"; exit 0
fi

# venv 解析：worktree 里通常没有自己的 .venv —— 退回主 checkout 的 .venv；
# editable 安装指向主仓 src，必须把本仓 src 放进 PYTHONPATH 才能测到本仓代码。
PY="$(pwd)/.venv/bin/python"
if [ ! -x "$PY" ]; then
  MAIN_ROOT="$(git rev-parse --path-format=absolute --git-common-dir)/.."
  if [ -x "$MAIN_ROOT/.venv/bin/python" ]; then
    PY="$MAIN_ROOT/.venv/bin/python"
    export PYTHONPATH="$(pwd)/src${PYTHONPATH:+:$PYTHONPATH}"
  else
    echo "    无可用 .venv，跳过"; exit 0
  fi
fi

if [ -d tests ]; then
  mkdir -p data/duckdb data/parquet data/cache
  if [ ! -f data/duckdb/lquant.duckdb ]; then
    echo "    DuckDB 未建库，先 init_db"
    "$PY" scripts/init_db.py
  fi

  # 只有「确认湖是空的、而且这个湖是本仓自己的」才造演示数据兜底。
  # 两个坑，都真实发生过（合成数据 21300 行覆盖进主湖 30 只标的）：
  # ① find 默认**不跟随符号链接**。worktree 里 data/parquet 常是指向主仓
  #    真实湖的软链（隔离姿势），不加 -L 会误判「湖为空」；
  # ② 即便真为空，软链指向的也是**别人的**湖，不该往里灌合成数据。
  # 所以：软链一律不兜底；跟随软链探测，只有真·空目录才生成。
  lake_empty=0
  if [ ! -L data/parquet ] \
     && ! find -L data/parquet -name '*.parquet' -print -quit 2>/dev/null | grep -q .; then
    lake_empty=1
  fi
  if [ "$lake_empty" = "1" ]; then
    echo "    无任何 parquet 数据，生成演示数据兜底（换真数据: ./lquant.sh bootstrap）"
    "$PY" -c "from lquant.cli.main import cli; cli(['data','demo'], standalone_mode=False)" >/dev/null
  fi
  # 测试策略（2026-10 起改为增量）：
  #   默认只跑「改动相关」的测试文件（scripts/test_changed.sh，文件名启发式
  #   映射 + 全局面改动自动回退全量）——300+ 文件全量 × --cov 插桩曾是 push
  #   的最大等待源，而它的两个产物各有归宿：
  #     · 失败拦截  → 改动相关测试 + CI 全量双保险，足够拦住；
  #     · 覆盖率门禁（diff-cover ≥95%）→ 移到 CI 用全量 coverage.xml 执行
  #       （本地增量测试的覆盖数据算不出可信的改动行覆盖，留在 pre-push 是
  #       名不副实的门禁）。本地想自查：make coverage && make diff-cov。
  #   全量逃生门：LQ_PUSH_FULL_TEST=1 git push（test_changed.sh 内识别）。
  #   跳过测试：LQ_SKIP_PUSH_CHECK=1 git push 或 git push --no-verify。
  if [ "${LQ_PUSH_FULL_TEST:-0}" = "1" ]; then
    echo "==> pre-push: 全量测试（LQ_PUSH_FULL_TEST=1）"
    "$PY" -m pytest -x -q tests/ || {
      echo "✗ 测试失败，修复后再 push（临时放行: LQ_SKIP_PUSH_CHECK=1 git push 或 git push --no-verify）"; exit 1; }
  else
    echo "==> pre-push: 改动相关测试（全量逃生门: LQ_PUSH_FULL_TEST=1 git push）"
    bash scripts/test_changed.sh || {
      echo "✗ 测试失败，修复后再 push（临时放行: LQ_SKIP_PUSH_CHECK=1 git push 或 git push --no-verify）"; exit 1; }
  fi
  echo "    覆盖率门禁（改动行 ≥95%）由 CI 全量执行；本地自查: make coverage && make diff-cov"
else
  echo "    无 tests/，跳过"
fi

echo "==> pre-push 通过"
